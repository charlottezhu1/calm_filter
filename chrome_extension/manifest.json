{
    "manifest_version": 3,
    "name": "Calm Filter",
    "description": "Scores the affect of posts in your feed, shows the affect distribution, and hides high-arousal negative posts.",
    "version": "1.0",
    "icons": {
        "16": "icon/image16.png",
        "32": "icon/image32.png",
        "48": "icon/image48.png",
        "64": "icon/image64.png",
        "128": "icon/image128.png"
    },

    "permissions": ["storage"],
    "host_permissions": [
        "*://*.twitter.com/*",
        "*://*.x.com/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "*://*.twitter.com/*",
                "*://*.x.com/*"
            ],
            "js": [
                "sentistrength_data.js",
                "sentistrength.js",
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_icon": "icon/image128.png",
        "default_popup": "settings.html"
    }
}
