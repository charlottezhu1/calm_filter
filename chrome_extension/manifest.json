{
    "manifest_version": 3,
    "name": "Calm Filter",
    "description": "Scores the affect of posts in your feed, shows the affect distribution, and hides high-arousal negative posts.",
    "version": "1.0",
    "icons": {
        "16": "icon/image16.png",
        "32": "icon/image32.png",
        "48": "icon/image48.png",
        "64": "icon/image64.png",
        "128": "icon/image128.png"
    },

    "permissions": ["storage"],
    "host_permissions": [
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.bsky.app/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "*://*.twitter.com/*",
                "*://*.x.com/*"
            ],
            "js": [
                "sentistrength_data.js",
                "sentistrength.js",
                "chart.js",
                "sites/x.js",
                "content.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://*.bsky.app/*"
            ],
            "js": [
                "sentistrength_data.js",
                "sentistrength.js",
                "chart.js",
                "sites/bluesky.js",
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_icon": "icon/image128.png",
        "default_popup": "settings.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "calm-filter@charlottezhu1.github.io",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}
